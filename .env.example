MANIFOLD_API_KEY=YOUR_API_KEY_HERE
DESIGNATED_USERNAME=MikhailTal
# Use paper mode for testing without real bets
PAPER_MODE=true
# Enable "super" mode to always use LLM assistance or "smart" mode to use LLM only for gray area bets less time and resources
STRATEGY_MODE=super
# OpenAI API configuration (instead of downloading a local LLM ollama)
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
#OPENAI_MODEL=gpt-5.2
# Ollama local LLM
# Make sure to have the model downloaded and running ollama server or even running the GUI app is enough
# Make sure to expose ollama to the network through port 11434 
OLLAMA_HOST=http://127.0.0.1:11434
#Choose the best model suitable for your needs and your machine
OLLAMA_MODEL=gpt-oss:120b-cloud
# Search providers
#These api are optional but they improve the LLM performance by giving it more context through web search
#Bing_API
BING_API_KEY=YOUR_BING_KEY_HERE
#BRAVE_API
BRAVE_API_KEY=YOUR_BRAVE_KEY_HERE
#SERP_API
SERPAPI_KEY=YOUR_SERPAPI_KEY_HERE
#SERPER_API
SERPER_API_KEY=YOUR_SERPER_KEY_HERE
# Optional tuning
# Time limit for LLM responses in seconds
LLM_TIMEOUT_SECONDS=300

# --- STRATEGY BET SIZING ---
BET_LARGE=30
BET_MEDIUM=20
BET_SMALL=10

BET_LARGE_THRESHOLD=0.15
BET_MEDIUM_THRESHOLD=0.30

# --- ML CONFIDENCE BOUNDS (OPTIONAL)---
# when ML confident either high or low it bets without assistance from LLM 
#But in super mode it asks LLM everytime
ML_CONFIDENT_HIGH=0.70
ML_CONFIDENT_LOW=0.30
ML_GRAY_LOW=0.50
ML_GRAY_HIGH=0.62

# --- BLENDING ---
# Weights for blending ML and LLM predictions
WEIGHT_ML=0.6
WEIGHT_LLM=0.4

#Max Number of Fetched markets From MikhailTal per search
MAX_FETCHED_MARKETS=19
#Max Number of pages to fetch from search APIs the api limit 1000 results per page
# therefore 10 pages equal 10000 results
MAX_PAGES=2

#Fetch resolved markets to train the model 
MAX_RESOLVED_MARKETS=500
